{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-site",
  "compatibility_date": "2026-04-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
