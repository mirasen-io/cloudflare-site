{
	"name": "@mirasen/main-website",
	"private": true,
	"version": "1.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"postinstall": "./scripts/npm-link.sh",
		"changeset:version": "changeset version && npm install && npm run format && git add --all",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/cli": "^0.1.22",
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.153.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true,
		"fsevents": true
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"@mirasen/chessboard": "^1.5.2",
		"chess.js": "^1.4.0"
	}
}
